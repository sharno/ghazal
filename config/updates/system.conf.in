[system]
compatible=@COMPATIBLE@
bootloader=uboot
bundle-formats=verity
mountprefix=/run/rauc
data-directory=/var/lib/rauc
boot-attempts=3
boot-attempts-primary=3

[keyring]
path=/etc/rauc/release.pem

[slot.rootfs.0]
device=/dev/mmcblk0p2
type=ext4
bootname=A

[slot.rootfs.1]
device=/dev/mmcblk0p5
type=ext4
bootname=B
