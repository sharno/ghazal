 /*----------------------------------------------------------------------------*/
+/* Reports the pin if it changed. Called with gpio->lock held. */
+static bool joypad_button_read(struct bt_gpio *gpio)
+{
+	int value = gpiod_get_value(gpio->desc);
+
+	if (value < 0 || value == gpio->old_value)
+		return false;
+	gpio->old_value = value;
+	input_event(gpio->joypad->input, gpio->report_type, gpio->linux_code, value);
+	input_sync(gpio->joypad->input);
+	return true;
+}
+
+static irqreturn_t joypad_button_irq(int irq, void *data)
+{
+	struct bt_gpio *gpio = data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&gpio->lock, flags);
+	/* While settling, the timer reads the pin when it fires. */
+	if (!gpio->settling) {
+		joypad_button_read(gpio);
+		gpio->settling = true;
+		hrtimer_start(&gpio->settle, ms_to_ktime(GHAZAL_BUTTON_SETTLE_MS),
+			      HRTIMER_MODE_REL);
+	}
+	spin_unlock_irqrestore(&gpio->lock, flags);
+	return IRQ_HANDLED;
+}
+
+static enum hrtimer_restart joypad_button_settled(struct hrtimer *timer)
+{
+	struct bt_gpio *gpio = container_of(timer, struct bt_gpio, settle);
+	enum hrtimer_restart next = HRTIMER_NORESTART;
+	unsigned long flags;
+
+	spin_lock_irqsave(&gpio->lock, flags);
+	/* A change found now bounces like any other: settle again. */
+	if (joypad_button_read(gpio)) {
+		hrtimer_forward_now(timer, ms_to_ktime(GHAZAL_BUTTON_SETTLE_MS));
+		next = HRTIMER_RESTART;
+	} else {
+		gpio->settling = false;
+	}
+	spin_unlock_irqrestore(&gpio->lock, flags);
+	return next;
+}
+
